# Terratraq configuration - copy to .env and fill in your values. DO NOT commit .env.

# Flask session signing key - use a long random string
SECRET_KEY=change-me-to-a-long-random-string

# MongoDB Atlas connection string
# Example: mongodb+srv://<dbUser>:<dbPassword>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Falls back to a local MongoDB at mongodb://localhost:27017 if unset.
MONGO_URI=
MONGO_DB_NAME=terratraq

# Admin account seeded on first boot (only used when no admin exists in the database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
